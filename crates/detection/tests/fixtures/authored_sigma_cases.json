        {
          "class": "process_exec",
          "process": "fodhelper.exe",
          "cmdline": "C:\\Windows\\System32\\fodhelper.exe",
          "parent": "explorer.exe"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "reg.exe",
          "cmdline": "reg add HKCU\\Software\\Vendor /v Theme /t REG_DWORD /d 1 /f",
          "parent": "cmd.exe"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "reg.exe",
          "cmdline": "reg query HKCU\\Software\\Classes\\ms-settings\\shell\\open\\command"
        }
      ]
    ]
  },
  {
    "id": "windows_wmi_event_subscription_persistence",
    "file": "rules/sigma/windows_wmi_event_subscription_persistence.yml",
    "must_fire": [
      [
        {
          "class": "process_exec",
          "process": "wmic.exe",
          "cmdline": "wmic /namespace:\\\\root\\subscription PATH __EventFilter CREATE Name=\"x\",EventNameSpace=\"root\\cimv2\"",
          "parent": "cmd.exe"
        }
      ]
    ],
    "must_not_fire": [
      [
        {
          "class": "process_exec",
          "process": "powershell.exe",
          "cmdline": "powershell.exe Get-WmiObject -Namespace root\\subscription -Class __EventFilter",
          "parent": "explorer.exe"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "powershell.exe",
          "cmdline": "powershell.exe Get-CimInstance -Namespace root/subscription -ClassName CommandLineEventConsumer",
          "parent": "explorer.exe"
        }
      ]
    ]
  },
  {
    "id": "windows_amsi_bypass_reflection",
    "file": "rules/sigma/windows_amsi_bypass_reflection.yml",
    "must_fire": [
      [
        {
          "class": "process_exec",
          "process": "powershell.exe",
          "cmdline": "[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)"
        }
      ]
    ],
    "must_not_fire": [
      [
        {
          "class": "process_exec",
          "process": "powershell.exe",
          "cmdline": "Get-MpComputerStatus"
        }
      ]
    ]
  },
  {
    "id": "windows_bits_notifycmdline_persistence",
    "file": "rules/sigma/windows_bits_notifycmdline_persistence.yml",
    "must_fire": [
      [
        {
          "class": "process_exec",
          "process": "bitsadmin.exe",
          "cmdline": "bitsadmin /SetNotifyCmdLine job1 C:\\Users\\Public\\x.exe NULL"
        }
      ]
    ],
    "must_not_fire": [
      [
        {
          "class": "process_exec",
          "process": "bitsadmin.exe",
          "cmdline": "bitsadmin /list /allusers"
        }
      ]
    ]
  }
]
