  {
    "id": "sigma_credential_access",
    "file": "rules/sigma/credential_access.yml",
    "must_fire": [
      [
        {
          "class": "file_open",
          "process": "cat",
          "file_path": "/etc/shadow",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "python3",
          "file_path": "/etc/shadow",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "cp",
          "file_path": "/etc/gshadow",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "perl",
          "file_path": "/etc/shadow"
        }
      ],
      [
        {
          "class": "file_open",
          "process": "python3.11",
          "file_path": "/etc/shadow"
        }
      ]
    ],
    "must_not_fire": [
      [
        {
          "class": "file_open",
          "process": "unix_chkpwd",
          "file_path": "/etc/shadow",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "sshd",
          "file_path": "/etc/shadow",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "ssh",
          "file_path": "/home/alice/.ssh/id_ed25519",
          "file_write": false
        }
      ],
      [
        {
          "class": "file_open",
          "process": "cat",
          "file_path": "/home/alice/.ssh/id_ed25519.pub",
          "file_write": false
        }
