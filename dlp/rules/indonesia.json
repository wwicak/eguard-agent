{
  "schema_version": "1",
  "pack_id": "indonesia",
  "version": "1.0.0",
  "rules": [
    {
      "id": "id.nik",
      "name": "Nomor Induk Kependudukan",
      "pattern": "\\b\\d{16}\\b",
      "validator": "nik_indonesia",
      "context": ["nik", "nomor induk kependudukan"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.kk",
      "name": "Kartu Keluarga",
      "pattern": "\\b\\d{16}\\b",
      "validator": "context_only",
      "context": ["kk", "kartu keluarga"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.npwp",
      "name": "NPWP format lama",
      "pattern": "\\b\\d{2}\\.\\d{3}\\.\\d{3}\\.\\d-\\d{3}\\.\\d{3}\\b",
      "validator": "npwp_indonesia",
      "context": ["npwp", "nomor pokok wajib pajak"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "DJP"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.npwp.new",
      "name": "NPWP format baru",
      "pattern": "\\b\\d{16}\\b",
      "validator": "context_only",
      "context": ["npwp", "nomor pokok wajib pajak"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "DJP"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.bpjs",
      "name": "Nomor peserta BPJS",
      "pattern": "\\b\\d{13}\\b",
      "validator": "context_only",
      "context": ["bpjs", "peserta bpjs"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "BPJS"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.phone",
      "name": "Nomor telepon Indonesia",
      "pattern": "(?:\\+62|08)[0-9][0-9 -]{7,12}[0-9]",
      "validator": "phone_indonesia",
      "context": ["telepon", "phone", "tel", "nomor"],
      "severity": "medium",
      "default_action": "audit",
      "regulations": ["UU PDP"],
      "redaction": "mask_middle",
      "max_matches": 20
    },
    {
      "id": "id.rekening",
      "name": "Nomor rekening Indonesia",
      "pattern": "\\b\\d{8,16}\\b",
      "validator": "context_only",
      "context": ["rekening", "no. rek", "nomor rekening", "account number"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "OJK", "BI"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.passport",
      "name": "Paspor Indonesia",
      "pattern": "\\b[A-Z][0-9]{7}\\b",
      "validator": "context_only",
      "context": ["paspor", "passport"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "Imigrasi"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.efin",
      "name": "e-FIN",
      "pattern": "\\b\\d{10}\\b",
      "validator": "context_only",
      "context": ["efin", "e-fin"],
      "severity": "high",
      "default_action": "alert",
      "regulations": ["UU PDP", "DJP"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.nib",
      "name": "Nomor Induk Berusaha",
      "pattern": "\\b\\d{13}\\b",
      "validator": "context_only",
      "context": ["nib", "nomor induk berusaha"],
      "severity": "medium",
      "default_action": "audit",
      "regulations": ["UU PDP", "OSS"],
      "redaction": "mask_middle",
      "max_matches": 10
    },
    {
      "id": "id.kartu_kredit",
      "name": "Kartu kredit",
      "pattern": "\\b(?:4[0-9]{15}|5[1-5][0-9]{14})\\b",
      "validator": "luhn",
      "context": ["kartu", "card", "kartu kredit", "credit card"],
      "severity": "critical",
      "default_action": "alert",
      "regulations": ["UU PDP", "PCI-DSS"],
      "redaction": "last4",
      "max_matches": 10
    },
    {
      "id": "id.ktp.cluster",
      "name": "KTP data cluster",
      "pattern": "\\b\\d{16}\\b",
      "validator": "context_cluster",
      "context": ["nama", "tempat lahir", "tanggal lahir", "alamat", "agama"],
      "severity": "critical",
      "default_action": "alert",
      "regulations": ["UU PDP"],
      "redaction": "mask_middle",
      "max_matches": 10
    }
  ]
}
