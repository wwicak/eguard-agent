{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eGuard DLP Rule Pack",
  "type": "object",
  "required": ["schema_version", "pack_id", "version", "rules"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "pattern", "validator", "context", "severity",
          "default_action", "regulations", "redaction", "max_matches"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^id\\.[a-z0-9_.-]+$"},
          "name": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1, "maxLength": 1024},
          "validator": {"type": "string", "minLength": 1},
          "context": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "default_action": {"enum": ["audit", "alert"]},
          "regulations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "redaction": {"enum": ["mask_middle", "last4"]},
          "max_matches": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
