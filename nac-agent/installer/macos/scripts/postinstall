#!/bin/sh
set -eu
# Root override is exclusively for sandbox tests; unset in package execution.
root=${EGUARD_NAC_TEST_ROOT:-}
mkdir -p "$root/usr/local/bin"
ln -sf '/Library/eGuard NAC/eguard-nac-service' "$root/usr/local/bin/eguard-nac"
chown root:wheel "$root/Library/LaunchDaemons/id.eguard.nac.plist"
chmod 644 "$root/Library/LaunchDaemons/id.eguard.nac.plist"
if [ -e "${EGUARD_NAC_TEST_STATE:-/Library/Application Support/eGuard NAC/state.json}" ]; then
 launchctl bootstrap system /Library/LaunchDaemons/id.eguard.nac.plist
fi
